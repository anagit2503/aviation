# Copy these names into Vercel → Project → Settings → Environment Variables.
# Nothing here is secret; it is a list of what to fill in.

# --- Booking storage (Upstash Redis via the Vercel Marketplace) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Booking emails (Resend) ---
RESEND_API_KEY=
BOOKING_EMAIL=samarthya.s02@gmail.com
# Once you verify your own domain in Resend, change this to something like
# SkyMaster <bookings@yourdomain.com>. Until then leave it unset.
# BOOKING_FROM=

# --- Google sign-in (Firebase) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Online payment (Razorpay) — add these only when your account is approved ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
