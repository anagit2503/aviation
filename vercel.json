{
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://flywithsam-46790.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://flywithsam-46790.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/reminders",
      "schedule": "30 3 * * *"
    }
  ]
}
